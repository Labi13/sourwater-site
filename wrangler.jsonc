{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sourwater",
  "main": "scripts/video-delivery.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/ai-content-film.mp4", "/assets/mermaids-need-space-720.mp4", "/assets/mermaids-need-space-1080.mp4", "/assets/mermaids-need-space-2k.mp4"]
  }
}
